<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.teamsai.saimockbank.domain.account.mapper.BankAccountMapper">

    <resultMap id="bankAccountResultMap"
               type="org.teamsai.saimockbank.domain.account.dto.BankAccountDTO">

        <id property="accountId" column="account_id"/>

        <result property="identityId" column="identity_id"/>

        <result property="userKey" column="user_key"/>
        <result property="userToken" column="user_token"/>
        <result property="bankCode" column="bank_code"/>
        <result property="accountNumber" column="account_number"/>
        <result property="accountName" column="account_name"/>
        <result property="accountHolderName" column="account_holder_name"/>
        <result property="balance" column="balance"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert"
            parameterType="org.teamsai.saimockbank.domain.account.dto.BankAccountDTO"
            useGeneratedKeys="true"
            keyProperty="accountId"
            keyColumn="account_id">

        INSERT INTO bank_account (
        identity_id,
        user_key,
        user_token,
        bank_code,
        account_number,
        account_name,
        account_holder_name,
        balance,
        status
        ) VALUES (
        #{identityId},
        #{userKey},
        #{userToken},
        #{bankCode},
        #{accountNumber},
        #{accountName},
        #{accountHolderName},
        #{balance},
        #{status}
        )
    </insert>

    <sql id="accountColumns">
        account_id,
        identity_id,
        user_key,
        user_token,
        bank_code,
        account_number,
        account_name,
        account_holder_name,
        balance,
        status,
        created_at,
        updated_at
    </sql>

    <select id="findAllByUserKey"
            resultMap="bankAccountResultMap">
        SELECT
        <include refid="accountColumns"/>
        FROM bank_account
        WHERE user_key = #{userKey}
        ORDER BY account_id ASC
    </select>

    <select id="findByUserKey" parameterType="string" resultType="org.teamsai.saimockbank.domain.account.dto.BankAccountDTO">
        SELECT *
        FROM bank_account
        WHERE user_key = #{userKey}
    </select>

    <select id="findByUserToken" resultType="org.teamsai.saimockbank.domain.account.dto.BankAccountDTO">
        SELECT DISTINCT
        a.account_id,
        a.account_number,
        a.account_name,
        a.account_holder_name,
        a.balance,
        a.user_token,
        a.created_at,
        a.updated_at
        FROM bank_account a
        JOIN bank_identity i ON a.identity_id = i.identity_id
        WHERE i.user_key_hash = #{userKey}
    </select>

    <select id="findById"
            resultMap="bankAccountResultMap">
        SELECT
        <include refid="accountColumns"/>
        FROM bank_account
        WHERE account_id = #{accountId}
    </select>

    <select id="findByBankCodeAndAccountNumber"
            resultMap="bankAccountResultMap">
        SELECT
        <include refid="accountColumns"/>
        FROM bank_account
        WHERE bank_code = #{bankCode}
        AND account_number = #{accountNumber}
    </select>

    <select id="findByIdForUpdate"
            resultMap="bankAccountResultMap">
        SELECT
        <include refid="accountColumns"/>
        FROM bank_account
        WHERE account_id = #{accountId}
        FOR UPDATE
    </select>

    <update id="decreaseBalance">
        UPDATE bank_account
        SET balance = balance - #{amount}
        WHERE account_id = #{accountId}
        AND balance >= #{amount}
    </update>

    <update id="increaseBalance">
        UPDATE bank_account
        SET balance = balance + #{amount}
        WHERE account_id = #{accountId}
    </update>

</mapper>